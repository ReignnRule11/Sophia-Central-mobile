{
  "name": "sophia-central-mobile",
  "slug": "sophia-central-mobile",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "splash": {
    "backgroundColor": "#0B1220"
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.sophiacentral.mobile"
  },
  "android": {
    "package": "com.sophiacentral.mobile",
    "adaptiveIcon": {
      "backgroundColor": "#0B1220"
    }
  },
  "web": {
    "bundler": "metro"
  },
  "plugins": [],
  "experiments": {
    "typedRoutes": false
  },
  "extra": {
    "apiUrl": "http://localhost:3000"
  }
}

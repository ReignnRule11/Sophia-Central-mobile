{
  "expo": {
    "name": "sophis-central-mobile",
    "slug": "sophia-central-mobile",
    "owner": "reignnrule1",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sophiscentral.mobile"
    },
    "android": {
      "package": "com.sophiscentral.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "64732baa-7807-4c73-904b-c146f5bf3ffe"
      }
    }
  }
}
